# Optional alternative to the root .env for frontend-only configuration.
# Never place the backend service-role key or Groq key in this file.

[supabase]
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY = "your-anon-or-publishable-key"

[backend]
url = "http://localhost:8000"

[google_oauth]
redirect_uri = "http://localhost:8501"
