# Copy this file to .env and replace the placeholders with your own values.
# Never commit the resulting .env file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_KEY=your-service-role-key

# Leave empty when Supabase issues asymmetric JWTs; the backend uses JWKS.
# Set only for a project that still issues legacy HS256 user tokens.
SUPABASE_JWT_SECRET=

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
SPACY_MODEL_PRIMARY=en_core_web_md
SPACY_MODEL_SECONDARY=en_core_web_sm

# Comma-separated frontend origins. Do not include a trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Copy these public values to frontend/.env.local. Never expose backend secrets
# such as SUPABASE_KEY or GROQ_API_KEY through a VITE_* variable.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
