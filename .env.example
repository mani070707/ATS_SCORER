# Copy this file to .env and replace the placeholders with your own values.
# Never commit the resulting .env file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_KEY=your-service-role-key

# Leave empty when Supabase issues asymmetric JWTs; the backend uses JWKS.
# Set only for a project that still issues legacy HS256 user tokens.
SUPABASE_JWT_SECRET=

GROQ_API_KEY=your-groq-api-key
AUTH_REDIRECT_URL=http://localhost:8501
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SPACY_MODEL_PRIMARY=en_core_web_md
SPACY_MODEL_SECONDARY=en_core_web_sm

# Comma-separated frontend origins. Do not include a trailing slash.
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
